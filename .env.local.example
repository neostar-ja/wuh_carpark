# Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key (Project Settings > API > service_role secret)
# NEVER expose this in client code — server-side only (lib/supabase.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for /admin (basic auth for now, swap for Supabase Auth later)
ADMIN_PASSWORD=

# Cloudflare Turnstile keys (dashboard.cloudflare.com > Turnstile)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
